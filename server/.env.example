# Copy to .env and adjust. Every value here has a working default for local dev.

# Public port. With the cluster launcher this is the balancer; instances sit
# on PORT+1, PORT+2, …
PORT=8787

# How many API instances `npm run cluster` starts.
INSTANCES=3

# Postgres. `npm run db` starts a local one on 55432 with these credentials.
# In production point this at your managed Postgres.
DATABASE_URL=postgres://soccerboard:soccerboard@127.0.0.1:55432/soccerboard

# Pooled connections PER INSTANCE. The database sees up to INSTANCES * this,
# so keep it well under Postgres' max_connections (100 by default).
PG_POOL_MAX=10

# Origin allowed to call the API with cookies. Must match the frontend exactly.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign session cookies. Generate your own before deploying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me

# Encrypts board contents at rest. 32 bytes of hex. Required in production;
# in development a key is derived from SESSION_SECRET if this is left unset.
# Losing this key makes existing boards permanently unreadable.
ENCRYPTION_KEY=

# Set to "production" behind HTTPS so cookies are marked Secure.
NODE_ENV=development

# --- Assistant (optional) ------------------------------------------------
# The assistant is rule-based and works fully offline. A key is ONLY used when
# the built-in parser does not recognise what was typed; leave this unset and
# the assistant behaves exactly as it always has, at no cost.
#
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# It is read server-side only and never reaches the browser.
GEMINI_API_KEY=

# One knob if the free tier moves to a different model name.
GEMINI_MODEL=gemini-2.5-flash
