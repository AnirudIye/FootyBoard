# Copy to .env and adjust. Every value here has a working default for local dev.

# Public port. With the cluster launcher this is the balancer; instances sit
# on PORT+1, PORT+2, …
PORT=8787

# How many API instances `npm run cluster` starts.
INSTANCES=3

# Postgres. `npm run db` starts a local one on 55432 with these credentials.
# In production point this at your managed Postgres.
#
# **Production refuses to boot without it**, the way it refuses an unrecognised
# APP_ENV, the placeholder SESSION_SECRET and a cleartext CORS_ORIGIN. Left
# unset on a real host the process used to fall back to the local role below,
# which either dies on a refused connection to an address nobody configured or,
# worse, comes up serving whatever is listening on that port on that host.
#
# THIS IS THE MOST POWERFUL SECRET IN THIS FILE, and until recently it was worth
# far more than it looks. The local role below is SUPERUSER and owns every
# table, so this string is not "read and write the app's data": it is control of
# the Postgres host. The same credential the API uses for SELECT also serves
# DROP TABLE, TRUNCATE, ALTER, CREATE ROLE and COPY ... TO PROGRAM. There is no
# backup behind board data, so the destructive half of that is unrecoverable.
#
# **In production, do not connect as the superuser or as the table owner.** Run
# `server/sql/runtime-role.sql` once against the database and point this at the
# role it creates. That role can SELECT, INSERT, UPDATE and DELETE the
# application's rows and can do nothing else at all -- no DDL, no roles, no
# reading another role's tables. `server/README.md` has the whole argument.
#
# It is deliberately NOT the role migrations run as, because `migrate()` issues
# DDL on every boot and a role without CREATE cannot get past the first
# statement. Two URLs, one privileged and used at deploy time, one restricted and
# used at runtime; see the README for how to sequence them.
#
# sslmode is the other half. `pg` does NOT negotiate TLS unless the connection
# string asks it to, so without this parameter the password above and every board
# row cross the network in cleartext -- which for a managed Postgres means across
# somebody else's network, and undoes ENCRYPTION_KEY at the one point the data is
# easiest to intercept. Use verify-full:
#
#   DATABASE_URL=postgres://soccerboard_app:...@db.example.com:5432/app?sslmode=verify-full
#
# One trap worth knowing before you test that URL. sslmode does not mean the same
# thing to this app as it means to psql. libpq reads `require` as "encrypt but
# verify nothing", which stops passive capture and not an active attacker who can
# answer for the host. node-postgres does not follow libpq here: it treats
# `prefer`, `require` and `verify-ca` as aliases for `verify-full`, and emits a
# security warning asking you to say what you mean. So a connection string you
# proved out with psql has proved nothing about what this process will accept,
# and the discrepancy runs in both directions. Write verify-full and the two
# agree.
#
# verify-full needs the server certificate to chain to a trusted CA and to match
# the hostname. Add &sslrootcert=/path/to/ca.pem where the system trust store
# does not already carry the provider's CA. There is also uselibpqcompat=true,
# which switches this driver back to libpq's weaker reading; that is the wrong
# direction here and is mentioned only so it is not mistaken for a fix.
#
# Local development is exempt and stays plain: the connection is a loopback
# socket to a database this repo started, so there is no network to protect and
# no certificate to verify.
DATABASE_URL=postgres://soccerboard:soccerboard@127.0.0.1:55432/soccerboard

# Pooled connections PER INSTANCE. The database sees up to INSTANCES * this,
# so keep it well under Postgres' max_connections (100 by default).
PG_POOL_MAX=10

# Origins allowed to call the API with cookies. Each must match a frontend
# exactly: scheme, host and port, no trailing slash and no path, because that is
# all a browser sends. Several may be listed, separated by commas — which is how
# a staging hostname gets a working socket as well as a page that loads:
#
#   CORS_ORIGIN=https://www.footyboard.me,https://tunnel.footyboard.me
#
# Every entry is held to the same rules, and in production every one of them
# must be https. The boot log prints the whole list.
CORS_ORIGIN=http://localhost:5173

# How many proxy hops of X-Forwarded-For to believe. LEAVE UNSET unless a proxy
# that overwrites the header sits in front of this instance: with it on, any
# caller can choose the address the per-IP rate limiters count them against,
# which is what protects the six-letter join code. `npm run cluster` sets it for
# its own children automatically.
TRUST_PROXY=

# Whether this instance runs the hourly housekeeping sweeps: expired sessions,
# spent reset links, stale rate-limit allowances, and session revocations older
# than the session TTL. Anything other than the literal "false" means yes, so an
# unset value sweeps.
#
# `npm run cluster` sets this to true for its first child and false for the
# rest, because one sweeper is enough and the rest would run the same DELETEs
# against the same rows. **A deployment that starts instances some other way
# (several containers, a process manager, a platform that scales them) has every
# one of them sweeping**, which is wasteful rather than wrong: the sweeps are
# idempotent DELETEs bounded by a timestamp. Set it to false on all but one if
# you care about the duplicated work.
RUN_MAINTENANCE=

# Whether this instance applies the schema at boot. Anything other than the
# literal "false" means yes, so an unset value migrates, which is what has
# always happened and is still the recommended arrangement.
#
# Set it to false ONLY when DATABASE_URL names the restricted role from
# `sql/runtime-role.sql`. That role has no DDL rights at all, so `migrate()`
# cannot get past its first statement as that role -- `CREATE TABLE IF NOT
# EXISTS users` is refused even though `users` exists, because Postgres checks
# the schema privilege before existence. Taking the two-role split therefore
# means applying the schema separately first, under the URL that owns the
# tables, and only then rolling the instances:
#
#   DATABASE_URL="$ADMIN_DATABASE_URL" npm --prefix server run migrate
#
# **That step is ordered and it is not optional.** Skipping it does not fail the
# boot any more: the instances come up healthy on an old schema and fail at
# query time instead, later and further from the cause. That is the whole cost
# of the split, and it is the reason the default is the other way round.
RUN_MIGRATIONS=

# What an instance calls itself in logs and in `GET /api/health`. Cosmetic, and
# the only reason it is written down here is that reading it in a health check
# and not finding it documented sends people looking for a feature.
INSTANCE_LABEL=

# Which deployment this is: development, test, or production. THIS IS A
# SECURITY SETTING, not a label. Two controls follow it and nothing else:
#
#   - production marks the session cookie Secure and sends HSTS on TLS requests;
#   - development and test may fall back to an encryption key derived from
#     SESSION_SECRET. Anything else must supply a real ENCRYPTION_KEY.
#
# An unrecognised value stops the process at boot rather than quietly choosing
# the permissive branch, which is what "staging" used to do to NODE_ENV: no
# Secure flag and real boards encrypted under a key computable from the
# placeholder two lines below. NODE_ENV is still read when APP_ENV is unset, so
# an existing deploy that sets it does not silently downgrade itself.
APP_ENV=development

# A real secret is REQUIRED in production and the process refuses to boot
# without one: unset, this exact placeholder, or anything under 32 characters
# all stop it, in the same way an unrecognised APP_ENV does.
#
# The name undersells what it protects, which is why it went unchecked for so
# long. It signs nothing; sessions are opaque random tokens stored as SHA-256.
# What it keys is the HMAC deciding which security question an address with NO
# account is shown. That has to be uncomputable offline, or an attacker derives
# the decoy for any address and flags every account whose real question differs.
# Left at the value below, that key is public: it is in this file, in the repo,
# and in the published mirror, and recovery step one becomes a way to test which
# addresses are registered.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me

# Encrypts board contents at rest, AES-256-GCM. EXACTLY 32 bytes of hex, so 64
# characters; anything else refuses to boot. Required unless APP_ENV is
# development or test, where a key is derived from SESSION_SECRET if this is
# left unset. Generate one with the same command as above, run a second time:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Do not reuse the SESSION_SECRET value here. They protect different things, and
# one string means one disclosure costs you both.
#
# **Losing this key makes existing boards permanently unreadable, and so does
# changing it**: there is no re-encryption path in this tree, so a rotation and a
# loss are the same operation as far as the stored rows are concerned. Nothing
# can enforce that you kept it. Put it in a secret store before the first deploy
# and keep a copy that survives the host. server/README.md, "Generating the
# secrets", has the rest.
ENCRYPTION_KEY=

# --- Assistant (optional) ------------------------------------------------
# The assistant is rule-based and works fully offline. A key is ONLY used when
# the built-in parser does not recognise what was typed; leave this unset and
# the assistant behaves exactly as it always has, at no cost.
#
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# It is read server-side only and never reaches the browser.
GEMINI_API_KEY=

# One knob if the free tier moves to a different model name. The default is the
# rolling alias, not a pinned version: this was gemini-2.5-flash until Google
# stopped serving that one to new keys, and the symptom is a bare 404 rather
# than anything that reads as a deprecation. Pin a version here only if you
# actually want one.
GEMINI_MODEL=gemini-flash-latest
